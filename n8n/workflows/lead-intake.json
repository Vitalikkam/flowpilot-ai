      "id": "5a993d32-af5a-42e6-9d3e-4257929dd80e",
      "name": "Webhook",
      "webhookId": "3d4d9720-3207-424a-a8ac-76b45878cc9d"
    },
    {
      "parameters": {
        "jsCode": "// The Webhook node output wraps the request as { headers, params, query, body }.\nconst body = $input.first().json.body ?? {};\n\nconst errors = [];\n\n// ── name ────────────────────────────────────────────────\nif (typeof body.name !== 'string' || body.name.trim().length === 0) {\n  errors.push('name is required');\n} else if (body.name.length > 200) {\n  errors.push('name must be at most 200 characters');\n}\n\n// ── email ───────────────────────────────────────────────\nif (typeof body.email !== 'string' || body.email.trim().length === 0) {\n  errors.push('email is required');\n} else if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(body.email)) {\n  errors.push('email is not valid');\n}\n\n// ── message ─────────────────────────────────────────────\nif (typeof body.message !== 'string' || body.message.trim().length === 0) {\n  errors.push('message is required');\n} else if (body.message.length > 5000) {\n  errors.push('message must be at most 5000 characters');\n}\n\n// ── source ──────────────────────────────────────────────\nconst allowedSources = ['website', 'email', 'form', 'api', 'other'];\nconst source = typeof body.source === 'string' && body.source.length > 0\n  ? body.source\n  : 'website';\nif (!allowedSources.includes(source)) {\n  errors.push(`source must be one of: ${allowedSources.join(', ')}`);\n}\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors,\n    lead: {\n      name: typeof body.name === 'string' ? body.name.trim() : '',\n      email: typeof body.email === 'string' ? body.email.trim().toLowerCase() : '',\n      company: typeof body.company === 'string' && body.company.trim().length > 0\n        ? body.company.trim()\n        : null,\n      message: typeof body.message === 'string' ? body.message.trim() : '',\n      source,\n    },\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
