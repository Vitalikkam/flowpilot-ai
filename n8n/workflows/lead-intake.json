      "name": "Create Lead"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama3.2\",\n  \"stream\": false,\n  \"format\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"summary\": {\"type\": \"string\"},\n      \"category\": {\n        \"type\": \"string\",\n        \"enum\": [\"web_development\", \"automation\", \"consulting\", \"other\"]\n      },\n      \"budget_usd\": {\"type\": [\"number\", \"null\"]},\n      \"urgency\": {\n        \"type\": \"string\",\n        \"enum\": [\"low\", \"medium\", \"high\"]\n      }\n    },\n    \"required\": [\"summary\", \"category\", \"budget_usd\", \"urgency\"]\n  },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You analyze inbound business leads. Extract ONLY information supported by the message. Do not invent a budget or deadline. Rules for urgency: 'high' if the lead wants to start within 30 days or expresses time pressure; 'medium' if within 1-3 months; 'low' otherwise. Return data matching the provided JSON schema exactly.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.lead.message) }}\n    }\n  ]\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 60000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1296,
        -144
      ],
      "id": "cce4264b-f081-4f50-97e4-e39fe8f30ec2",
      "name": "Analyze Lead"
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst raw = response?.message?.content;\n\nif (typeof raw !== 'string' || raw.length === 0) {\n  throw new Error('Ollama returned no content');\n}\n\nlet ai;\ntry {\n  ai = JSON.parse(raw);\n} catch (e) {\n  throw new Error('Ollama returned invalid JSON: ' + raw.slice(0, 300));\n}\n\n// Pull the original lead from the Create Lead node.\nconst lead = $('Create Lead').item.json;\n\nreturn [{\n  json: {\n    lead,\n    ai: {\n      summary: ai.summary,\n      category: ai.category,\n      budget_usd: ai.budget_usd ?? null,\n      urgency: ai.urgency,\n    },\n    model: 'llama3.2',\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1456,
        -144
      ],
      "id": "9c5ba7e0-779d-4c08-b583-890cc47dd4a0",
      "name": "Parse AI Output"
    },
    {
      "parameters": {
        "jsCode": "// $json comes from Parse AI Output: { lead, ai, model }\nconst { lead, ai, model } = $json;\nconst errors = [];\n\n\n// ── summary ─────────────────────────────────────────────\nif (typeof ai.summary !== 'string') {\n  errors.push('summary is not a string');\n} else if (ai.summary.trim().length === 0) {\n  errors.push('summary is empty');\n} else if (ai.summary.length > 2000) {\n  errors.push('summary exceeds 2000 characters');\n}\n\n// ── category ────────────────────────────────────────────\nconst validCategories = ['web_development', 'automation', 'consulting', 'other'];\nif (!validCategories.includes(ai.category)) {\n  errors.push(`category must be one of: ${validCategories.join(', ')}`);\n}\n\n// ── urgency ─────────────────────────────────────────────\nconst validUrgencies = ['low', 'medium', 'high'];\nif (!validUrgencies.includes(ai.urgency)) {\n  errors.push(`urgency must be one of: ${validUrgencies.join(', ')}`);\n}\n\n// ── budget_usd ──────────────────────────────────────────\nif (ai.budget_usd !== null && ai.budget_usd !== undefined) {\n  if (\n    typeof ai.budget_usd !== 'number' ||\n    !isFinite(ai.budget_usd) ||\n    ai.budget_usd < 0\n  ) {\n    errors.push('budget_usd must be null or a non-negative number');\n  }\n}\n\nconst valid = errors.length === 0;\n\nreturn [{\n  json: {\n    valid,\n    errors,\n    lead,\n    // Only pass ai forward when it's valid — downstream nodes\n    // can then treat it as trustworthy.\n    ai: valid ? ai : null,\n    model,\n  },\n}];"
      },
